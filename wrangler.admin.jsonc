{
  "name": "seolbaek-admin",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "vars": {
    "GITHUB_OWNER": "progen-ai-kr",
    "GITHUB_REPO": "seolbaek-tensorflow",
    "GITHUB_REPOS": "seolbaek-tensorflow,seolbaek-vertex",
    "GITHUB_BRANCH": "main",
    "ADMIN_ENABLED": "true",
    "ADMIN_STANDALONE": "true",
    "ADMIN_URL": "https://seolbaek-admin.progen-web.workers.dev/admin",
    "PUBLIC_SITE_URL": "https://seolbaek-tensorflow.progen-web.workers.dev"
  }
}
